{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notpanel-miniapp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot", "/hooks/*", "/setup/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notpanel",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Every minute: order status backup check + the next step of a price sync when one is running/due
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Comma-separated Telegram user IDs that can open the Admin panel
    "OWNER_IDS": "",
    // Local development only (set in .dev.vars). Must stay empty in production.
    "DEV_FAKE_USER_ID": ""
  }
}
